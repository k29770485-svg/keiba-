# SQLAlchemy MySQL/MariaDB URL。必ず実環境の強固な認証情報に置換してください。
DATABASE_URL=mysql+pymysql://keiba_app:change_me@127.0.0.1:3306/keiba?charset=utf8mb4

# Geminiを併用する場合だけ必要です。SQL方式の決定論的スコアリングでは使用しません。
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# バッチ制御
PREDICTION_LEAD_MINUTES=10
PREDICTION_WINDOW_SECONDS=60
LOCK_LEASE_SECONDS=300
SCHEDULER_INTERVAL_SECONDS=60

# sql: race_market_snapshotsに保存された発走前入力だけを使用（本番推奨）。
# mock: ローカル検証用。integration: 許可済みの実データアダプタを実装後に使用。
DATA_PROVIDER=sql
SQL_ALGORITHM_VERSION=sql-v3-ev-strict
TICKET_STAKE_YEN=100

# 厳格な期待値フィルター。校正済み組合せ確率・券種別発走前払戻見込みがない場合は見送り。
# 直近2週間程度の小標本では下記件数を満たさないため、意図どおり投資額は0円になります。
VALUE_MIN_CALIBRATION_SAMPLE_SIZE=250
VALUE_PROBABILITY_CONFIDENCE_Z=1.96
VALUE_MIN_CONSERVATIVE_EV_PCT=35
VALUE_MIN_MARKET_EDGE_PCT=50
VALUE_MAX_TICKETS_PER_RACE=1
# 確定払戻の遅延・訂正に備え、直近の日次集計を毎回再構築する日数。
DAILY_PERFORMANCE_LOOKBACK_DAYS=7
LOG_LEVEL=INFO
