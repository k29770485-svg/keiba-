# SQLAlchemy MySQL/MariaDB URL。必ず実環境の強固な認証情報に置換してください。
DATABASE_URL=mysql+pymysql://keiba_app:change_me@127.0.0.1:3306/keiba?charset=utf8mb4

# Gemini Developer API の API キー。値は絶対にリポジトリへコミットしないでください。
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# バッチ制御
PREDICTION_LEAD_MINUTES=10
PREDICTION_WINDOW_SECONDS=60
LOCK_LEASE_SECONDS=300
SCHEDULER_INTERVAL_SECONDS=60

# mock: ローカル検証用。integration: 許可済みの実データアダプタを実装後に使用。
DATA_PROVIDER=mock
LOG_LEVEL=INFO
